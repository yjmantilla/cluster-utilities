#!/usr/bin/env bash
# DEPRECATED — cluster-run has been retired (proved unreliable; agents mishandled its
# exit-42 / master-check semantics). Call ssh directly instead.
#
# The shared ControlMaster (opened by `cluster-login`) means a plain ssh reuses the socket
# with no Duo. Add `-o BatchMode=yes` so it FAILS FAST instead of hanging on a Duo prompt
# when the master is down:
#
#   OLD:  cluster-run <host> <cmd...>
#   NEW:  ssh -o BatchMode=yes <host> <cmd...>
#
# On "Permission denied (...keyboard-interactive)" the master is down — refresh it with
# `cluster-login <host>` (approve the Duo push), then re-run the ssh.
#
# This stub only prints the equivalent command and exits non-zero; it never connects.
set -euo pipefail

echo "cluster-run is DEPRECATED — do not use it." >&2
if [ $# -ge 2 ]; then
  host="$1"; shift
  echo "Run this instead:" >&2
  echo "  ssh -o BatchMode=yes $host $*" >&2
else
  echo "Run instead:  ssh -o BatchMode=yes <host> <cmd...>" >&2
fi
echo "If it fails with 'Permission denied', the master is down — refresh: cluster-login <host>" >&2
exit 64
